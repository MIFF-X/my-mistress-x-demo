{
  "dashboard": {
    "id": null,
    "uid": null,
    "title": "Mistress-X Analytics Cache",
    "tags": ["analytics","cache"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "30s",
    "panels": [
      {
        "type": "stat",
        "title": "Cache Hits",
        "datasource": "Prometheus",
        "targets": [{ "expr": "sum(rate(analytics_cache_hits_total[5m]))", "refId": "A" }],
        "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 }
      },
      {
        "type": "stat",
        "title": "Cache Misses",
        "datasource": "Prometheus",
        "targets": [{ "expr": "sum(rate(analytics_cache_misses_total[5m]))", "refId": "B" }],
        "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 }
      },
      {
        "type": "graph",
        "title": "Hit Ratio",
        "datasource": "Prometheus",
        "targets": [{ "expr": "(sum(rate(analytics_cache_hits_total[5m])) / (sum(rate(analytics_cache_hits_total[5m])) + sum(rate(analytics_cache_misses_total[5m])))) * 100", "refId": "C" }],
        "gridPos": { "x": 0, "y": 4, "w": 12, "h": 6 }
      },
      {
        "type": "graph",
        "title": "Redis GET Latency (ms)",
        "datasource": "Prometheus",
        "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(analytics_cache_get_duration_seconds_bucket[5m])) by (le))", "refId": "D" }],
        "gridPos": { "x": 0, "y": 10, "w": 12, "h": 6 }
      }
    ]
  }
}